# Create with: cp .env.example .env
# Get an API key and number from https://app.goguava.ai
GUAVA_API_KEY=gva-replace-me
GUAVA_AGENT_NUMBER=+15551234567

# OpenAI vision analyzes one evidence frame after COCO-SSD sees at least one person.
OAI_API_KEY=sk-replace-me
OAI_VISION_MODEL=gpt-5.6-luna

# Optional. Defaults to ./runtime
BEACON_RUNTIME_DIR=runtime
