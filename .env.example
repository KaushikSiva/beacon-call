# Copy to .env and replace every placeholder. Never commit .env.

# Robot-to-BeaconCall API authentication.
BEACON_API_TOKEN=replace-with-a-long-random-value
BEACON_API_URL=http://127.0.0.1:8080

# LiveKit Cloud project and stored Twilio-backed outbound trunk.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_SIP_TRUNK_ID=ST_replace_me

# Server-side destination. It is never accepted from an incident request or returned by the API.
BEACON_DESTINATION_NUMBER=+15551234567

# OpenAI vision, transcription, and speech.
OPENAI_API_KEY=sk-replace-me
OAI_VISION_MODEL=gpt-5.6-luna

# Optional. Defaults to ./runtime
BEACON_RUNTIME_DIR=runtime
